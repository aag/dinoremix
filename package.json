{
  "name": "dinosaur-remix",
  "version": "0.1.0",
  "author": "Adam Goforth",
  "description": "A web app for remixing Dinosaur Comics",
  "license": "GPL-2.0",
  "homepage": "http://dinoremix.definingterms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aag/dinoremix.git"
  },
  "bugs": {
    "url": "https://github.com/aag/dinoremix/issues"
  },
  "dependencies": {
    "mithril": "^2.3.8"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.6",
    "@rspack/core": "^2.2.6",
    "@rspack/dev-server": "^2.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.22.1",
    "jsdom": "^30.1.0",
    "mithril-query": "^4.0.1",
    "ospec": "^4.1.1",
    "rspack-merge": "^1.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "scripts": {
    "build": "rspack --mode production --config rspack.prod.js",
    "check-style": "eslint public/assets && stylelint \"public/assets/css/**/*.css\"",
    "fix-style": "eslint public/assets --fix",
    "start": "rspack --config rspack.dev.js --watch",
    "test": "ospec 'public/assets/**/*.test.js' --preload ./test-setup.js"
  }
}
